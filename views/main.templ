package views

import "fmt"
import "nkpro/gotempl/views/components"
import "nkpro/gotempl/views/layout"

func itoa(i int) string { return fmt.Sprintf("%d", i) }

type PageUser struct {
    Email string
    Name string
    Avatar string
}

type MainProps struct {
    User PageUser
    Popular []NewsCard
    Latest []NewsCard
    PopPage int
    LastPage int
    PageSize int
    PopTotal int
    LastTotal int
    PopPrev int
    PopNext int
    LastPrev int
    LastNext int
}

templ Main(props MainProps) {
	@layout.Layout(layout.LayoutProps{
		Title: "Новости",
		MetaDescription: "Лента новостей",
	}) {
		<main>
            @layout.Header(layout.HeaderProps{ Email: props.User.Email, Name: props.User.Name, Avatar: props.User.Avatar }) {
				@components.Title("Новости")
			}
            @components.Categories([]components.Category{
                {Title: "Еда", Image: "/public/images/Hashtag_food.svg", Alias: "eda"},
                {Title: "Животные", Image: "/public/images/Hashtag_animal.svg", Alias: "zhivotnye"},
                {Title: "Машины", Image: "/public/images/Hashtag_car.svg", Alias: "mashiny"},
                {Title: "Спорт", Image: "/public/images/Hashtag_sport.svg", Alias: "sport"},
                {Title: "Музыка", Image: "/public/images/Hashtag_music.svg", Alias: "muzyka"},
                {Title: "Технологии", Image: "/public/images/Hashtag_technology.svg", Alias: "tehnologii"},
                {Title: "Прочее", Image: "/public/images/Hashtag_others.svg", Alias: "prochee"},
            })
			<style>
				.hero-row { display: flex; gap: 24px; align-items: stretch; width: 100%; max-width: 1290px; margin: 24px auto 0; }
				.hero-left { width: 744px; display: flex; flex-direction: row; gap: 24px; }
				.hero-right { flex: 1; min-width: 0; }
			</style>
			<div class="hero-row">
				<div class="hero-left">
					@components.Banner(components.BannerProps{Image: "/public/images/banner_1.png", Alt: "Автомобиль баннер", Title: "Как безопасно водить", Description: "Длинный текст про то, как можно безопасно водить автомобиль."})
					@components.Banner(components.BannerProps{Image: "/public/images/banner_2.png", Alt: "Музыка баннер", Title: "Создавай музыку!", Description: "Сегодня мы рассмотрим технику быстрого создания музыки за счёт использования..."})
				</div>
				<div class="hero-right">
					@components.Slider([]components.SliderItem{
						{Image: "/public/images/banner_1.png", Alt: "Автомобиль баннер", Title: "Как безопасно водить", Description: "Длинный текст про то, как можно безопасно водить автомобиль."},
						{Image: "/public/images/banner_2.png", Alt: "Музыка баннер", Title: "Создавай музыку!", Description: "Сегодня мы рассмотрим технику быстрого создания музыки за счёт использования..."},
					})
				</div>
			</div>
            <div id="popular" style="max-width: 1290px; margin: 24px auto 0;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <h2 style="margin: 0 0 12px;">Популярное</h2>
                    <div>
                        <a href={"/?pop=" + itoa(props.PopPrev) + "&last=" + itoa(props.LastPage) + "#popular"} class="arrow">‹</a>
                        <a href={"/?pop=" + itoa(props.PopNext) + "&last=" + itoa(props.LastPage) + "#popular"} class="arrow">›</a>
                    </div>
                </div>
                <div style="display: flex; gap: 24px; flex-wrap: nowrap; overflow: hidden;">
                for _, it := range props.Popular {
                    @components.Card(components.CardProps{ Image: it.Image, Title: it.Title, Description: it.Description, User: it.User, Bookmarked: false })
                }
                </div>
            </div>
            <div id="latest" style="max-width: 1290px; margin: 32px auto 40px;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <h2 style="margin: 0 0 12px;">Последние новости</h2>
                    <div>
                        <a href={"/?pop=" + itoa(props.PopPage) + "&last=" + itoa(props.LastPrev) + "#latest"} class="arrow">‹</a>
                        <a href={"/?pop=" + itoa(props.PopPage) + "&last=" + itoa(props.LastNext) + "#latest"} class="arrow">›</a>
                    </div>
                </div>
                <div style="display: flex; gap: 24px; flex-wrap: nowrap; overflow: hidden;">
                for _, it := range props.Latest {
                    @components.Card(components.CardProps{ Image: it.Image, Title: it.Title, Description: it.Description, User: it.User, Bookmarked: false })
                }
                </div>
            </div>
            <style>
                .arrow { display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:50%; background:#f2f2f2; text-decoration:none; color:#333; margin-left:8px; box-shadow:0 2px 6px rgba(0,0,0,0.08); }
            </style>
			@layout.Footer()
		</main>
	}
}